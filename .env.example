# Copy to .env and fill in. Never commit .env.

# Neon Postgres — pooled connection (app runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Neon Postgres — direct connection (Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Gmail SMTP — order confirmation email (SMTP_PASS is a Gmail App Password, not the account password)
# If SMTP_USER / SMTP_PASS are empty, orders still work and the email is skipped.
SMTP_USER="you@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
MAIL_FROM="Neythra <you@gmail.com>"

# Public site URL — used for links and images in the email (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin dashboard login
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# Secret that signs the admin session cookie — any long random string (e.g. `openssl rand -base64 32`)
AUTH_SECRET="replace-with-a-long-random-string"
